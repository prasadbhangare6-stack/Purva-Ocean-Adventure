# ==========================================================================
# PURVA OCEAN ADVENTURES — environment variables (EXAMPLE ONLY)
#
# Copy this file to `.env.local` for local development and fill in values
# from your own accounts. `.env.local` is git-ignored. NEVER commit real values.
# NEVER prefix secrets with NEXT_PUBLIC_.
# ==========================================================================

# ---- Public (safe for the browser) ---------------------------------------
# Sanity project ID from sanity.io/manage. Leave empty to run without a CMS.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-06-01
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server only (NEVER expose to the browser) ----------------------------
# Read token (Viewer role) — only needed for preview/draft or admin reads.
SANITY_API_READ_TOKEN=
# Shared secret used by the Sanity webhook to call /api/revalidate.
# Generate with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=
# Secret for signing admin sessions (once the auth provider is approved).
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Local design preview ONLY. Lets you view /admin without a real login.
# Ignored when NODE_ENV=production. Remove it once authentication is live.
# Allowed: owner | admin | editor | enquiry_manager | viewer
ADMIN_DEV_PREVIEW_ROLE=

# ---- Google Sheets (future enquiry sync — server only) -------------------
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the quotes and \n escapes exactly as Google provides them.
GOOGLE_PRIVATE_KEY=
